NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kaduna-electric

# JWT
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_EXPIRE=7d

# Payment Mode: demo | paystack
PAYMENT_MODE=demo

# Registration access control
# Use * to allow any email in local/demo mode.
ALLOWED_REGISTER_EMAILS=*
ALLOWED_REGISTER_DOMAINS=*

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# Resend email API
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Kaduna Electric <verify@your-verified-domain.com>
# Existing sender fallback when RESEND_FROM_EMAIL is not set
SMTP_FROM=Kaduna Electric <noreply@kadunaelectric.com>

# Admin
ADMIN_SECRET_KEY=admin-setup-key-12345
